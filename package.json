{
  "name": "deepseek-kernel-harness",
  "version": "0.2.1",
  "description": "Linux kernel dev domain plugin for DeepSeek Harness (dsh): verification pyramid L1-L4 as model-facing tools + graph-layer governance (anti-Goodhart / blind-spot / patch-conflict) + AGENTS.md contract as a system-prompt section. Plain JS, no build step.",
  "type": "module",
  "main": "cordis/index.js",
  "files": [
    "tools/",
    "governance/",
    "engines/",
    "hooks/pre-commit.sample",
    "templates/",
    "AGENTS.md",
    "deepseek_host.py",
    "engine_probe.py",
    "plugin.json",
    "README.md",
    "INTEGRATION.md",
    "ROADMAP.md",
    "LICENSE",
    "cordis/index.js",
    "cordis/cordis.patch.yml",
    "cordis/test/drive.mjs",
    "cordis/test/run.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "linux-kernel",
    "agent-harness",
    "verification"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leemiracle/deepseek-kernel-harness"
  }
}